{
  "framework": "nextjs",
  "regions": ["iad1"],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/launchpad/keeper",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reorg-sweep",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-orders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/market-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/agent-scout-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/genesis-digest",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/kol-consensus-archive",
      "schedule": "0 0 * * *"
    }
  ]
}
