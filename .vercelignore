# ============================================================================
# VERCEL CONTROL PLANE ISOLATION (.vercelignore)
# ============================================================================
# Leading '/' anchors each rule strictly to the repository root so nested
# folders like packages/launchpad/contracts/ and packages/shared/contracts/
# are NEVER accidentally excluded.
# Enforces AGENTS.md Rule 1 (Control Plane Isolation) & Rule 3 (Non-Custodial).
# ============================================================================

# Local Environment & Secrets (NEVER upload local .env to Vercel)
/.env
/.env.*

# Legacy Omnichain CLI Bot & Daemon Artifacts
/src/
/scripts/
/sites/
/wallets/
/promotions/
/characters/
/.eliza/
/.wrangler/
/logs/
/cache/
/out/
/scratch/
/services/
/templates/

# Execution Plane (100% decoupled from Vercel Control Plane)
/apps/execution-plane/

# Root Smart Contract Sources & Local Deployments
/contracts/
/deployments/

# Tests & Documentation
/tests/
/test/
/docs/
/design-system/
/*.md
!README.md
tsconfig.tsbuildinfo
