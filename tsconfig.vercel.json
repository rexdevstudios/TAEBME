{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["packages/*"],
      "@/*": ["*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "app/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "node_modules",
    "src",
    "apps/execution-plane",
    "sites",
    "scripts",
    "tests",
    "test"
  ]
}
